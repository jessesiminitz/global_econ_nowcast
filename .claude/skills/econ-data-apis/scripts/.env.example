# Copy this file to .env (in this same scripts/ directory) and fill in
# whatever keys you have. Never commit the real .env — it's git-ignored.
#
# Every key here is also read from a real shell environment variable first
# (e.g. `export FRED_API_KEY=...` in ~/.zshrc) — this file is only a
# fallback for when that's not convenient.

# Required for Haver Analytics (py: scripts/haver.py). No free tier —
# needs a Haver subscription.
HAVER_API_KEY=

# Optional for FRED (scripts/fred.py) — without it, fred.py falls back to
# the unauthenticated fredgraph.csv scrape, which is more prone to rate
# limiting. Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional for BEA (scripts/bea.py) — required to use it at all (BEA has
# no keyless tier). Free signup: https://apps.bea.gov/API/signup/
BEA_API_KEY=

# Optional for BLS (scripts/bls.py) — works keyless at a lower rate limit
# and shorter history window; a free key raises both. Free signup:
# https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# Optional: override where the DuckDB cache file lives. Defaults to
# ./econ_data.duckdb relative to wherever you run the scripts from.
# ECON_DATA_DB_PATH=/path/to/econ_data.duckdb

# IMF, World Bank, OECD, Eurostat, and ECB SDW are all keyless — nothing
# to set for scripts/imf.py, worldbank.py, oecd.py, eurostat.py, ecb.py.
